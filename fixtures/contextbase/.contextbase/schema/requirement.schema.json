{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metis.xmartlabs.com/schemas/requirement.schema.json",
  "title": "Requirement entry frontmatter",
  "description": "Frontmatter de una entrada knowledge/requirements/*.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "title", "date", "resolution", "evidence", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^REQ-[0-9]{4}$" },
    "type": { "const": "requirement" },
    "status": { "type": "string", "enum": ["proposed", "confirmed", "superseded", "discarded", "disputed"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "raised_by": { "type": "array", "items": { "type": "string" } },
    "resolution": { "type": "string", "enum": ["open", "closed", "out_of_scope"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[0-9]{4}$" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": {
          "source": { "type": "string", "enum": ["meeting", "slack", "mail", "confluence", "notion", "document", "code", "tracker", "manual"] },
          "ref": { "type": "string", "minLength": 1 },
          "locator": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["FACT", "INFERENCE", "UNKNOWN", "CONFLICT"] }
  }
}
