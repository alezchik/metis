{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metis.xmartlabs.com/schemas/decision.schema.json",
  "title": "Decision entry frontmatter",
  "description": "Frontmatter de una entrada knowledge/decisions/*.md. Ver docs/design/spec-tecnica-funcional.md seccion 4.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "title", "date", "evidence", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^DEC-[0-9]{4}$" },
    "type": { "const": "decision" },
    "status": { "type": "string", "enum": ["proposed", "confirmed", "superseded", "discarded", "disputed"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "decided_by": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "supersedes": { "type": ["string", "null"], "pattern": "^DEC-[0-9]{4}$" },
    "superseded_by": { "type": ["string", "null"], "pattern": "^DEC-[0-9]{4}$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": {
          "source": { "type": "string", "enum": ["meeting", "slack", "mail", "confluence", "notion", "document", "spreadsheet", "image", "code", "tracker", "manual"] },
          "ref": { "type": "string", "minLength": 1 },
          "locator": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["FACT", "INFERENCE", "UNKNOWN", "CONFLICT"] }
  },
  "allOf": [
    {
      "comment": "decided_by solo es obligatorio una vez que alguien decidio de verdad -- confirmed o superseded. proposed/disputed pueden no tener todavia un decisor (seccion 4.3; ver docs/adr/0004-decided-by-condicional.md).",
      "if": { "properties": { "status": { "enum": ["confirmed", "superseded"] } }, "required": ["status"] },
      "then": { "required": ["decided_by"] }
    }
  ]
}
