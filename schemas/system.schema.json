{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metis.xmartlabs.com/schemas/system.schema.json",
  "title": "System entry frontmatter",
  "description": "Frontmatter de una entrada knowledge/systems/*.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "title", "date", "evidence", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^SYS-[a-z0-9-]+$" },
    "type": { "const": "system" },
    "status": { "type": "string", "enum": ["proposed", "confirmed", "superseded", "discarded", "disputed"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "owner": { "type": "array", "items": { "type": "string" } },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^SYS-[a-z0-9-]+$" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": {
          "source": { "type": "string", "enum": ["meeting", "slack", "mail", "confluence", "notion", "document", "code", "manual"] },
          "ref": { "type": "string", "minLength": 1 },
          "locator": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["FACT", "INFERENCE", "UNKNOWN", "CONFLICT"] }
  }
}
